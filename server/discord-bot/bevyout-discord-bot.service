[Unit]
Description=Bevyout GitHub Discord personality bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=azureuser
Group=azureuser
WorkingDirectory=/opt/bevyout-discord-bot
EnvironmentFile=/etc/bevyout-discord-bot.env
ExecStart=/usr/bin/python3 /opt/bevyout-discord-bot/server.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
